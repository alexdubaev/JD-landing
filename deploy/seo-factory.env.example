# Release B SEO Factory shadow-mode controls. Keep every boolean false until
# staging migration, role/token permission checks, and an owner-approved shadow
# run are complete. This file contains placeholders only.
SEO_FACTORY_ENABLED=false
SEO_FACTORY_PRODUCTION_SCHEDULE=false
SEO_FACTORY_ALLOW_APPLY=false
SEO_FACTORY_ALLOW_PUBLISH=false
SEO_FACTORY_MAX_URLS_PER_RUN=100
SEO_FACTORY_MAX_WORK_ITEMS_PER_RUN=100
SEO_FACTORY_REQUEST_TIMEOUT_MS=5000
# Interval between daemon ticks in ms (default 900000 = 15 minutes).
SEO_FACTORY_INTERVAL_MS=900000
SEO_FACTORY_WORKER_ROLE_ID=
SEO_WORKER_TOKEN_FILE=/run/secrets/seo-worker-token
