{
	email {$ACME_EMAIL}
	admin off
}

(security_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

# The public site is the sole exception to SAMEORIGIN framing: Directus Studio
# may embed an authenticated preview, but only from the configured CMS origin.
(security_headers_public) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "frame-ancestors 'self' https://cms.deere-shop.ru"
	}
}

# The preview bridge must submit its short-lived, signed token to the public
# frontend. Keep the exception limited to the bridge response; all other CMS
# routes retain the stricter default policy below.
(security_headers_preview_bridge) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; form-action https://deere-shop.ru; base-uri 'none'; frame-ancestors 'self'"
	}
}

# HTTP→HTTPS redirect for apex and www (preserves path + query)
http://deere-shop.ru, http://www.deere-shop.ru {
	redir https://deere-shop.ru{uri} permanent
}

# www→apex redirect (preserves path + query)
www.deere-shop.ru {
	redir https://deere-shop.ru{uri} permanent
}

# Plain IP access (health checks, internal) — no redirect
http://91.227.68.176 {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 20MB
	}

	reverse_proxy frontend:3000
}

deere-shop.ru {
	import security_headers_public
	# Directus Live Preview is embedded only by the trusted CMS origin.
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	redir /index.html / permanent
	redir /index.php / permanent
	redir /index / permanent

	reverse_proxy frontend:3000 {
		# Next.js emits its own SAMEORIGIN value, after the generic response
		# header handler has run. Remove that upstream value at the proxy
		# boundary so the explicit CSP frame-ancestors policy takes effect.
		header_down -X-Frame-Options
	}
}

cms.deere-shop.ru {
	encode zstd gzip

	request_body {
		max_size 50MB
	}

	@preview_bridge path /deere-shop/preview/*
	handle @preview_bridge {
		import security_headers_preview_bridge
		reverse_proxy directus:8055
	}

	handle {
		import security_headers
		reverse_proxy directus:8055
	}
}
