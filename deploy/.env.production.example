# =============================================================================
# Production environment for jd-landing (deere-shop.ru)
# -----------------------------------------------------------------------------
# Copy to /opt/jd-landing/.env on the VPS and fill in real values.
# This file is consumed by deploy/compose.production.yml and deploy/deploy.sh.
# NEVER commit the real .env. It must exist ONLY at /opt/jd-landing/.env.
# =============================================================================

# ---- PostgreSQL (Directus database) ----
POSTGRES_DB=directus
POSTGRES_USER=directus
POSTGRES_PASSWORD=replace-with-a-long-random-password

# ---- Directus core ----
DIRECTUS_SECRET=replace-with-a-long-random-secret
DIRECTUS_ADMIN_EMAIL=info@cmteh.ru
DIRECTUS_ADMIN_PASSWORD=replace-with-a-long-random-password

# ---- Next.js frontend (server-only secrets below) ----
# Static token of the "Frontend API" Directus role (min 20 chars). NEVER expose
# via NEXT_PUBLIC_* — it bypasses public policy and must stay server-side.
DIRECTUS_TOKEN=replace-with-frontend-api-static-token
# UUID of the Directus public folder used for absolute asset URLs.
DIRECTUS_PUBLIC_FOLDER_ID=1ecf70c5-0ad4-4e5e-8d73-78ee549f064a
# Shared secret checked by POST /api/revalidate via the x-revalidate-secret
# header. Must match the secret configured in the Directus revalidation webhook.
REVALIDATE_SECRET=replace-with-a-long-random-secret

# ---- Caddy / TLS ----
ACME_EMAIL=info@cmteh.ru

# ---- Cloudflare Turnstile (lead-form spam protection) ----
# Configure both together. The site key is baked into the build via
# NEXT_PUBLIC_TURNSTILE_SITE_KEY; the secret is verified server-side in /api/leads.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key

# ---- Manager lead notifications (SMTP, all optional) ----
# When unset, email notifications are silently disabled and leads are still
# stored in Directus.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# ---- IndexNow (optional, accelerates Yandex/Bing re-crawl after CMS edits) ----
# A random key. The same value must be served at https://deere-shop.ru/<KEY>.txt
# (place the file in frontend/public/). Wired into compose.production.yml
# (frontend.environment); when unset, IndexNow pings are skipped.
INDEXNOW_KEY=

# ---- Release A optional controls ----
# Keep Basic Auth disabled until the owner provisions the hash and approves the
# Caddy change. deploy.sh fails before compose mutation if enabled incomplete.
ENABLE_DIRECTUS_CMS_BASIC_AUTH=false
DIRECTUS_CMS_AUTH_USER=
DIRECTUS_CMS_AUTH_HASH=

# Restic is not part of Release A. Keep this false until a restore-tested
# backup release is reviewed and deployed separately.
ENABLE_RESTIC_BACKUP=false
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
