      { "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "relationMark", "attrs": { "id": "22222222-2222-4222-8222-222222222222", "junction": "editor_nodes", "collection": "categories" } }], "text": "Оформить заявку" }] },
      { "type": "relationInlineBlock", "attrs": { "id": "33333333-3333-4333-8333-333333333333", "junction": "editor_nodes", "collection": "categories" } },
      { "type": "heading", "attrs": { "level": 3 }, "content": [{ "type": "text", "text": "Сравнение" }] },
      { "type": "table", "content": [
        { "type": "tableRow", "content": [
