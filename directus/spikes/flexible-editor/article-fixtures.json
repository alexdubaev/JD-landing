  "securityCorpus": [
    {
      "name": "script node must be rejected",
      "doc": { "type": "doc", "content": [{ "type": "script", "attrs": { "src": "https://evil/x.js" } }] }
    },
    {
      "name": "javascript: href must be rejected",
      "doc": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "link", "attrs": { "href": "javascript:alert(1)" } }], "text": "bad" }] }] }
    },
    {
      "name": "data: href must be rejected",
      "doc": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "link", "attrs": { "href": "data:text/html,<script>alert(1)</script>" } }], "text": "bad" }] }] }
