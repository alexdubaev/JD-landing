DIRECTUS_VERSION=12.1.1

POSTGRES_DB=directus
POSTGRES_USER=directus
POSTGRES_PASSWORD=replace-with-a-strong-database-password

DIRECTUS_SECRET=replace-with-a-long-random-secret

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Used by the managed Directus Flow after an editor saves public content.
NEXT_REVALIDATE_URL=http://host.docker.internal:3000/api/revalidate
REVALIDATE_SECRET=replace-with-the-same-long-secret-as-the-frontend
