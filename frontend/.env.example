DIRECTUS_URL=https://cms.deere-shop.ru
DIRECTUS_TOKEN=replace-with-a-server-only-static-token
DIRECTUS_PUBLIC_FOLDER_ID=1ecf70c5-0ad4-4e5e-8d73-78ee549f064a
NEXT_PUBLIC_SITE_URL=https://deere-shop.ru
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-cloudflare-site-key
TURNSTILE_SECRET_KEY=replace-with-cloudflare-secret-key
REVALIDATE_SECRET=replace-with-a-long-random-secret
# IndexNow: must match the key file served at /<KEY>.txt in /public.
# Enables Yandex/Bing instant re-crawl pings after Directus revalidation.
INDEXNOW_KEY=0f81321649a7e9ba734d09aeb5a47c5a
# Manager lead notifications via SMTP. All optional — when unset, notifications
# are silently disabled and leads are still stored in Directus. Enable by
# setting SMTP_HOST/PORT/USER/PASSWORD + NOTIFY_EMAIL_TO together.
# SMTP_SECURE: set to "true" for implicit TLS (port 465); omit for STARTTLS.
# SMTP_FROM: optional sender address; defaults to SMTP_USER.
# Configured for Yandex 360 (mail for cmteh.ru): port 465 = implicit TLS.
# SMTP_PASSWORD must be an App Password (created in Yandex account security),
# NOT the mailbox login password — Yandex rejects the main password over SMTP.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@cmteh.ru
SMTP_PASSWORD=
SMTP_FROM=info@cmteh.ru
NOTIFY_EMAIL_TO=info@cmteh.ru
